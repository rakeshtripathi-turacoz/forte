# ============================================================================
# FORTE INSTITUTE WEBSITE - PRODUCTION FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
#
# This file is used when building for production (npm run build)
# Copy this to .env.production and update with your production values
#
# ============================================================================

# Production Backend API URL
# Replace with your actual production API domain
REACT_APP_API_URL=https://api.forteinstitute.edu/api

# Application Environment
REACT_APP_ENV=production

# Application Name
REACT_APP_NAME=Forte Institute of Technology

# ============================================================================
# DEPLOYMENT NOTES:
# ============================================================================
#
# Netlify/Vercel:
#   - Set environment variables in their dashboard
#   - Don't rely on .env files in production
#
# Traditional Hosting (cPanel, AWS):
#   - Ensure .env.production is present during build
#   - Run: npm run build
#   - Deploy the 'build' folder
#
# Docker:
#   - Pass env vars using docker-compose or Dockerfile
#   - Example: docker run -e REACT_APP_API_URL=https://api.example.com
#
# ============================================================================
