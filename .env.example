# ============================================================================
# FORTE INSTITUTE WEBSITE - FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env
# 2. Update the values according to your environment
# 3. Never commit .env to version control
#
# ============================================================================

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------

# Backend API URL
# Development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api
REACT_APP_API_URL=http://localhost:5000/api

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# Application name (optional)
REACT_APP_NAME=Forte Institute of Technology

# Environment (development, staging, production)
REACT_APP_ENV=development

# ----------------------------------------------------------------------------
# Feature Flags (optional)
# ----------------------------------------------------------------------------

# Enable debug mode (shows console logs)
# REACT_APP_DEBUG=true

# Enable analytics (optional)
# REACT_APP_ANALYTICS_ID=your-analytics-id

# ----------------------------------------------------------------------------
# Notes:
# ----------------------------------------------------------------------------
# - All React environment variables must start with REACT_APP_
# - Changes require restart of development server (npm start)
# - Production builds use values from .env.production if available
# - File URLs will automatically use REACT_APP_API_URL as base
# ============================================================================
