import React, { useState, useEffect } from 'react';
import { admissionAPI } from '../../services/api';
import API_CONFIG from '../../config/api.config';

const API_URL = API_CONFIG.API_URL;

const ManageAdmissionsPage = () => {
  const [activeTab, setActiveTab] = useState('enquiries');
  const [enquiries, setEnquiries] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');
  const [selectedEnquiry, setSelectedEnquiry] = useState(null);
  const [filterStatus, setFilterStatus] = useState('');
  const [searchTerm, setSearchTerm] = useState('');

  // Pagination
  const [currentPage, setCurrentPage] = useState(1);
  const [totalPages, setTotalPages] = useState(1);
  const itemsPerPage = 10;

  // Content management state
  const [headerData, setHeaderData] = useState(null);
  const [programs, setPrograms] = useState([]);
  const [processSteps, setProcessSteps] = useState([]);
  const [paymentInfo, setPaymentInfo] = useState(null);
  const [documents, setDocuments] = useState([]);
  const [contacts, setContacts] = useState([]);

  // Load data based on active tab
  useEffect(() => {
    if (activeTab === 'enquiries') {
      loadEnquiries();
    } else if (activeTab === 'header') {
      loadHeader();
    } else if (activeTab === 'programs') {
      loadPrograms();
    } else if (activeTab === 'steps') {
      loadProcessSteps();
    } else if (activeTab === 'payment') {
      loadPaymentInfo();
    } else if (activeTab === 'documents') {
      loadDocuments();
    } else if (activeTab === 'contacts') {
      loadContacts();
    }
  }, [activeTab, filterStatus, currentPage]);

  // ============ ENQUIRIES MANAGEMENT ============
  const loadEnquiries = async () => {
    try {
      setLoading(true);
      setError('');

      const params = {
        limit: itemsPerPage,
        offset: (currentPage - 1) * itemsPerPage
      };

      if (filterStatus) {
        params.status = filterStatus;
      }

      const response = await admissionAPI.getEnquiries(params);

      if (response.success) {
        setEnquiries(response.data);
        setTotalPages(response.totalPages || 1);
      }
    } catch (error) {
      setError('Failed to load enquiries');
      console.error(error);
    } finally {
      setLoading(false);
    }
  };

  const handleUpdateStatus = async (id, newStatus, notes = '') => {
    try {
      setLoading(true);
      setError('');
      setSuccess('');

      await admissionAPI.updateStatus(id, newStatus, notes);
      setSuccess('Status updated successfully!');

      loadEnquiries();
      setSelectedEnquiry(null);
    } catch (error) {
      setError('Failed to update status');
    } finally {
      setLoading(false);
    }
  };

  const handleDeleteEnquiry = async (id) => {
    if (!window.confirm('Are you sure you want to delete this enquiry?')) return;

    try {
      setLoading(true);
      await admissionAPI.deleteEnquiry(id);
      setSuccess('Enquiry deleted successfully!');
      loadEnquiries();
    } catch (error) {
      setError('Failed to delete enquiry');
    } finally {
      setLoading(false);
    }
  };

  const handleViewDetails = (enquiry) => {
    setSelectedEnquiry(enquiry);
  };

  // ============ CONTENT MANAGEMENT ============
  const loadHeader = async () => {
    try {
      setLoading(true);
      const response = await fetch(`${API_URL}/admission/header`);
      const data = await response.json();
      if (data.success) {
        setHeaderData(data.data || {
          title: 'Admissions',
          subtitle: 'Join Our Community | Your Journey to Excellence Starts Here',
          description: '',
          banner_image_url: ''
        });
      }
    } catch (error) {
      console.error('Error loading header:', error);
    } finally {
      setLoading(false);
    }
  };

  const loadPrograms = async () => {
    try {
      setLoading(true);
      const response = await fetch(`${API_URL}/admission/programs`);
      const data = await response.json();
      if (data.success) {
        setPrograms(data.data);
      }
    } catch (error) {
      console.error('Error loading programs:', error);
    } finally {
      setLoading(false);
    }
  };

  const loadProcessSteps = async () => {
    try {
      setLoading(true);
      const response = await fetch(`${API_URL}/admission/process-steps`);
      const data = await response.json();
      if (data.success) {
        setProcessSteps(data.data);
      }
    } catch (error) {
      console.error('Error loading process steps:', error);
    } finally {
      setLoading(false);
    }
  };

  const loadPaymentInfo = async () => {
    try {
      setLoading(true);
      const response = await fetch(`${API_URL}/admission/payment-info`);
      const data = await response.json();
      if (data.success) {
        setPaymentInfo(data.data || {
          account_name: '',
          bank_name: '',
          account_number: '',
          ifsc_code: '',
          branch_name: ''
        });
      }
    } catch (error) {
      console.error('Error loading payment info:', error);
    } finally {
      setLoading(false);
    }
  };

  const loadDocuments = async () => {
    try {
      setLoading(true);
      const response = await fetch(`${API_URL}/admission/documents`);
      const data = await response.json();
      if (data.success) {
        setDocuments(data.data);
      }
    } catch (error) {
      console.error('Error loading documents:', error);
    } finally {
      setLoading(false);
    }
  };

  const loadContacts = async () => {
    try {
      setLoading(true);
      const response = await fetch(`${API_URL}/admission/contacts`);
      const data = await response.json();
      if (data.success) {
        setContacts(data.data);
      }
    } catch (error) {
      console.error('Error loading contacts:', error);
    } finally {
      setLoading(false);
    }
  };

  // ============ HELPER FUNCTIONS ============
  const getStatusColor = (status) => {
    const colors = {
      new: 'bg-blue-100 text-blue-800',
      contacted: 'bg-yellow-100 text-yellow-800',
      followup: 'bg-purple-100 text-purple-800',
      enrolled: 'bg-green-100 text-green-800',
      rejected: 'bg-red-100 text-red-800'
    };
    return colors[status] || 'bg-gray-100 text-gray-800';
  };

  const getStatusLabel = (status) => {
    const labels = {
      new: 'New',
      contacted: 'Contacted',
      followup: 'Follow Up',
      enrolled: 'Enrolled',
      rejected: 'Rejected'
    };
    return labels[status] || status;
  };

  const filteredEnquiries = enquiries.filter(enquiry => {
    if (!searchTerm) return true;

    const search = searchTerm.toLowerCase();
    return (
      enquiry.full_name?.toLowerCase().includes(search) ||
      enquiry.email?.toLowerCase().includes(search) ||
      enquiry.mobile_number?.includes(search) ||
      enquiry.program_interested?.toLowerCase().includes(search)
    );
  });

  // ============ RENDER TABS ============
  const renderEnquiriesTab = () => (
    <div>
      {/* Filters and Search */}
      <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
        <div className="grid md:grid-cols-3 gap-4">
          {/* Search */}
          <div>
            <label className="block text-sm font-semibold text-gray-700 mb-2">
              <i className="fas fa-search mr-2"></i>
              Search
            </label>
            <input
              type="text"
              placeholder="Name, email, phone, program..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crimson focus:border-crimson"
            />
          </div>

          {/* Status Filter */}
          <div>
            <label className="block text-sm font-semibold text-gray-700 mb-2">
              <i className="fas fa-filter mr-2"></i>
              Filter by Status
            </label>
            <select
              value={filterStatus}
              onChange={(e) => {
                setFilterStatus(e.target.value);
                setCurrentPage(1);
              }}
              className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crimson focus:border-crimson"
            >
              <option value="">All Status</option>
              <option value="new">New</option>
              <option value="contacted">Contacted</option>
              <option value="followup">Follow Up</option>
              <option value="enrolled">Enrolled</option>
              <option value="rejected">Rejected</option>
            </select>
          </div>

          {/* Stats */}
          <div className="flex items-end">
            <div className="w-full bg-crimson bg-opacity-10 p-3 rounded-lg">
              <div className="text-sm text-gray-600">Total Enquiries</div>
              <div className="text-2xl font-bold text-crimson">{enquiries.length}</div>
            </div>
          </div>
        </div>
      </div>

      {/* Enquiries List */}
      <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 className="text-lg font-bold text-slate mb-4">
          Admission Enquiries ({filteredEnquiries.length})
        </h2>

        {loading && enquiries.length === 0 ? (
          <div className="text-center py-8 text-gray-500">
            <i className="fas fa-spinner fa-spin text-2xl mb-2"></i>
            <p>Loading enquiries...</p>
          </div>
        ) : filteredEnquiries.length === 0 ? (
          <div className="text-center py-8 text-gray-500">
            <i className="fas fa-inbox text-4xl mb-2"></i>
            <p>No enquiries found</p>
            {searchTerm && <p className="text-sm mt-2">Try adjusting your search filters</p>}
          </div>
        ) : (
          <div className="space-y-3">
            {filteredEnquiries.map((enquiry) => (
              <div
                key={enquiry.id}
                className="border border-gray-200 rounded-lg p-4 hover:shadow-md transition"
              >
                <div className="flex justify-between items-start">
                  <div className="flex-1">
                    <div className="flex items-center gap-3 mb-2">
                      <h3 className="text-lg font-bold text-slate">{enquiry.full_name}</h3>
                      <span className={`px-3 py-1 rounded-full text-xs font-semibold ${getStatusColor(enquiry.status)}`}>
                        {getStatusLabel(enquiry.status)}
                      </span>
                    </div>

                    <div className="grid md:grid-cols-2 gap-2 text-sm text-gray-600">
                      <div>
                        <i className="fas fa-envelope mr-2 text-gray-400"></i>
                        {enquiry.email}
                      </div>
                      <div>
                        <i className="fas fa-phone mr-2 text-gray-400"></i>
                        {enquiry.mobile_number}
                      </div>
                      <div>
                        <i className="fas fa-graduation-cap mr-2 text-gray-400"></i>
                        Program: <span className="font-semibold">{enquiry.program_interested?.toUpperCase()}</span>
                      </div>
                      <div>
                        <i className="fas fa-calendar mr-2 text-gray-400"></i>
                        DOB: {new Date(enquiry.date_of_birth).toLocaleDateString()}
                      </div>
                    </div>

                    {enquiry.notes && (
                      <div className="mt-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-sm">
                        <i className="fas fa-sticky-note mr-2 text-yellow-600"></i>
                        <strong>Notes:</strong> {enquiry.notes}
                      </div>
                    )}

                    <div className="mt-2 text-xs text-gray-400">
                      <i className="fas fa-clock mr-1"></i>
                      Submitted: {new Date(enquiry.created_at).toLocaleString()}
                    </div>
                  </div>

                  <div className="flex flex-col gap-2 ml-4">
                    <button
                      onClick={() => handleViewDetails(enquiry)}
                      className="text-blue-600 hover:text-blue-800 px-3 py-1 rounded border border-blue-300 hover:bg-blue-50 transition text-sm"
                      title="View Details"
                    >
                      <i className="fas fa-eye mr-1"></i>
                      View
                    </button>
                    <button
                      onClick={() => handleDeleteEnquiry(enquiry.id)}
                      className="text-red-600 hover:text-red-800 px-3 py-1 rounded border border-red-300 hover:bg-red-50 transition text-sm"
                      title="Delete"
                    >
                      <i className="fas fa-trash mr-1"></i>
                      Delete
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* Pagination */}
        {totalPages > 1 && (
          <div className="mt-6 flex justify-center gap-2">
            <button
              onClick={() => setCurrentPage(prev => Math.max(1, prev - 1))}
              disabled={currentPage === 1}
              className="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <i className="fas fa-chevron-left"></i> Previous
            </button>

            <span className="px-4 py-2 bg-gray-100 rounded-lg">
              Page {currentPage} of {totalPages}
            </span>

            <button
              onClick={() => setCurrentPage(prev => Math.min(totalPages, prev + 1))}
              disabled={currentPage === totalPages}
              className="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Next <i className="fas fa-chevron-right"></i>
            </button>
          </div>
        )}
      </div>

      {/* Details Modal */}
      {selectedEnquiry && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div className="p-6">
              {/* Modal Header */}
              <div className="flex justify-between items-start mb-6">
                <div>
                  <h2 className="text-2xl font-bold text-slate mb-2">Enquiry Details</h2>
                  <span className={`px-3 py-1 rounded-full text-xs font-semibold ${getStatusColor(selectedEnquiry.status)}`}>
                    {getStatusLabel(selectedEnquiry.status)}
                  </span>
                </div>
                <button
                  onClick={() => setSelectedEnquiry(null)}
                  className="text-gray-400 hover:text-gray-600"
                >
                  <i className="fas fa-times text-xl"></i>
                </button>
              </div>

              {/* Personal Information */}
              <div className="mb-6">
                <h3 className="text-lg font-bold text-slate mb-3 border-b pb-2">Personal Information</h3>
                <div className="grid md:grid-cols-2 gap-4">
                  <div>
                    <label className="text-sm font-semibold text-gray-600">Full Name</label>
                    <p className="text-gray-900">{selectedEnquiry.full_name}</p>
                  </div>
                  <div>
                    <label className="text-sm font-semibold text-gray-600">Father's Name</label>
                    <p className="text-gray-900">{selectedEnquiry.father_name}</p>
                  </div>
                  <div>
                    <label className="text-sm font-semibold text-gray-600">Date of Birth</label>
                    <p className="text-gray-900">{new Date(selectedEnquiry.date_of_birth).toLocaleDateString()}</p>
                  </div>
                  <div>
                    <label className="text-sm font-semibold text-gray-600">Category</label>
                    <p className="text-gray-900">{selectedEnquiry.category?.toUpperCase()}</p>
                  </div>
                </div>
              </div>

              {/* Contact Information */}
              <div className="mb-6">
                <h3 className="text-lg font-bold text-slate mb-3 border-b pb-2">Contact Information</h3>
                <div className="grid md:grid-cols-2 gap-4">
                  <div>
                    <label className="text-sm font-semibold text-gray-600">Email</label>
                    <p className="text-gray-900">{selectedEnquiry.email}</p>
                  </div>
                  <div>
                    <label className="text-sm font-semibold text-gray-600">Mobile Number</label>
                    <p className="text-gray-900">{selectedEnquiry.mobile_number}</p>
                  </div>
                  <div className="md:col-span-2">
                    <label className="text-sm font-semibold text-gray-600">Address</label>
                    <p className="text-gray-900">{selectedEnquiry.address}</p>
                  </div>
                </div>
              </div>

              {/* Program Information */}
              <div className="mb-6">
                <h3 className="text-lg font-bold text-slate mb-3 border-b pb-2">Program Information</h3>
                <div>
                  <label className="text-sm font-semibold text-gray-600">Program Interested</label>
                  <p className="text-gray-900 text-lg font-semibold">{selectedEnquiry.program_interested?.toUpperCase()}</p>
                </div>
              </div>

              {/* Update Status */}
              <div className="mb-6">
                <h3 className="text-lg font-bold text-slate mb-3 border-b pb-2">Update Status</h3>
                <div className="flex flex-wrap gap-2">
                  {['new', 'contacted', 'followup', 'enrolled', 'rejected'].map(status => (
                    <button
                      key={status}
                      onClick={() => handleUpdateStatus(selectedEnquiry.id, status)}
                      className={`px-4 py-2 rounded-lg font-semibold transition ${
                        selectedEnquiry.status === status
                          ? 'bg-crimson text-white'
                          : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                      }`}
                      disabled={loading}
                    >
                      {getStatusLabel(status)}
                    </button>
                  ))}
                </div>
              </div>

              {/* Notes */}
              <div className="mb-6">
                <h3 className="text-lg font-bold text-slate mb-3 border-b pb-2">Notes</h3>
                <textarea
                  defaultValue={selectedEnquiry.notes || ''}
                  onBlur={(e) => {
                    if (e.target.value !== selectedEnquiry.notes) {
                      handleUpdateStatus(selectedEnquiry.id, selectedEnquiry.status, e.target.value);
                    }
                  }}
                  placeholder="Add notes about this enquiry..."
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crimson focus:border-crimson"
                  rows="4"
                />
              </div>

              {/* Metadata */}
              <div className="text-xs text-gray-500 border-t pt-3">
                <div>Enquiry ID: #{selectedEnquiry.id}</div>
                <div>Submitted: {new Date(selectedEnquiry.created_at).toLocaleString()}</div>
                {selectedEnquiry.updated_at && (
                  <div>Last Updated: {new Date(selectedEnquiry.updated_at).toLocaleString()}</div>
                )}
              </div>

              {/* Close Button */}
              <div className="mt-6 flex justify-end">
                <button
                  onClick={() => setSelectedEnquiry(null)}
                  className="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-semibold hover:bg-gray-300 transition"
                >
                  Close
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );

  const renderContentManagementInfo = (title, description) => (
    <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div className="text-center py-12">
        <i className="fas fa-tools text-6xl text-gray-300 mb-4"></i>
        <h3 className="text-xl font-bold text-slate mb-2">{title}</h3>
        <p className="text-gray-600 mb-4">{description}</p>
        <p className="text-sm text-gray-500">
          Please use database management tools or create admin forms to manage this content.
        </p>
      </div>

      {/* Quick View */}
      {activeTab === 'programs' && programs.length > 0 && (
        <div className="mt-6 border-t pt-6">
          <h4 className="font-bold text-slate mb-4">Current Programs ({programs.length})</h4>
          <div className="space-y-2">
            {programs.map(program => (
              <div key={program.id} className="p-3 bg-gray-50 rounded border border-gray-200">
                <div className="font-semibold">{program.program_name} ({program.program_code})</div>
                <div className="text-sm text-gray-600">Level: {program.program_level} | {program.affiliation}</div>
              </div>
            ))}
          </div>
        </div>
      )}

      {activeTab === 'documents' && documents.length > 0 && (
        <div className="mt-6 border-t pt-6">
          <h4 className="font-bold text-slate mb-4">Required Documents ({documents.length})</h4>
          <div className="space-y-2">
            {documents.map((doc, index) => (
              <div key={doc.id} className="p-3 bg-gray-50 rounded border border-gray-200 flex items-center gap-3">
                <span className="bg-crimson text-white w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold">
                  {index + 1}
                </span>
                <div className="flex-1">
                  <div className="font-semibold">{doc.document_name}</div>
                  <div className="text-xs text-gray-600">
                    {doc.is_mandatory ? 'Mandatory' : 'Optional'} | For: {doc.applicable_for}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {activeTab === 'contacts' && contacts.length > 0 && (
        <div className="mt-6 border-t pt-6">
          <h4 className="font-bold text-slate mb-4">Support Contacts ({contacts.length})</h4>
          <div className="space-y-2">
            {contacts.map(contact => (
              <div key={contact.id} className="p-3 bg-gray-50 rounded border border-gray-200">
                <div className="font-semibold">{contact.contact_title}</div>
                <div className="text-sm text-gray-600">
                  {contact.contact_type}: {contact.contact_value}
                  {contact.available_hours && ` | ${contact.available_hours}`}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );

  return (
    <div>
      {/* Header */}
      <div className="mb-6">
        <h1 className="text-2xl font-serif font-bold text-slate mb-2">Manage Admissions</h1>
        <p className="text-sm text-gray-600">View enquiries and manage admission page content</p>
      </div>

      {/* Success/Error Messages */}
      {success && (
        <div className="mb-4 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg">
          <i className="fas fa-check-circle mr-2"></i>
          {success}
        </div>
      )}

      {error && (
        <div className="mb-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg">
          <i className="fas fa-exclamation-circle mr-2"></i>
          {error}
        </div>
      )}

      {/* Tabs */}
      <div className="mb-6 border-b border-gray-200">
        <div className="flex gap-2 sm:gap-4 overflow-x-auto">
          <button
            onClick={() => setActiveTab('enquiries')}
            className={`pb-3 px-2 sm:px-4 font-semibold border-b-2 transition whitespace-nowrap text-sm sm:text-base ${
              activeTab === 'enquiries'
                ? 'border-crimson text-crimson'
                : 'border-transparent text-gray-500 hover:text-slate'
            }`}
          >
            <i className="fas fa-inbox mr-2"></i>
            Enquiries
          </button>
          <button
            onClick={() => setActiveTab('programs')}
            className={`pb-3 px-2 sm:px-4 font-semibold border-b-2 transition whitespace-nowrap text-sm sm:text-base ${
              activeTab === 'programs'
                ? 'border-crimson text-crimson'
                : 'border-transparent text-gray-500 hover:text-slate'
            }`}
          >
            <i className="fas fa-graduation-cap mr-2"></i>
            Programs
          </button>
          <button
            onClick={() => setActiveTab('documents')}
            className={`pb-3 px-2 sm:px-4 font-semibold border-b-2 transition whitespace-nowrap text-sm sm:text-base ${
              activeTab === 'documents'
                ? 'border-crimson text-crimson'
                : 'border-transparent text-gray-500 hover:text-slate'
            }`}
          >
            <i className="fas fa-file-alt mr-2"></i>
            Documents
          </button>
          <button
            onClick={() => setActiveTab('contacts')}
            className={`pb-3 px-2 sm:px-4 font-semibold border-b-2 transition whitespace-nowrap text-sm sm:text-base ${
              activeTab === 'contacts'
                ? 'border-crimson text-crimson'
                : 'border-transparent text-gray-500 hover:text-slate'
            }`}
          >
            <i className="fas fa-phone mr-2"></i>
            Contacts
          </button>
        </div>
      </div>

      {/* Tab Content */}
      {activeTab === 'enquiries' && renderEnquiriesTab()}
      {activeTab === 'programs' && renderContentManagementInfo(
        'Programs Management',
        'Manage UG and PG programs offered by the institute.'
      )}
      {activeTab === 'documents' && renderContentManagementInfo(
        'Documents Management',
        'Manage required documents for admission process.'
      )}
      {activeTab === 'contacts' && renderContentManagementInfo(
        'Contacts Management',
        'Manage helpline numbers and support contacts.'
      )}
    </div>
  );
};

export default ManageAdmissionsPage;
